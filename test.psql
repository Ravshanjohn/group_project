    -- }

--Consume_Token
CREATE OR REPLACE FUNCTION consume_token(
  param_token_type type_token_type,
  param_token TEXT
)
RETURNS TABLE (
  success BOOLEAN,
  user_id BIGINT
)
LANGUAGE plpgsql
AS $$
DECLARE
  v_user_id BIGINT;
  v_token_id BIGINT;
BEGIN

  -- 1. Atomically find + consume token (i.e., mark as revoked)
  UPDATE tokens
  SET revoked = TRUE
  WHERE token = param_token
    AND token_type = param_token_type
    AND expires_at > NOW()
    AND revoked = FALSE
  RETURNING id INTO v_token_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Invalid or expired token';
  END IF;

  -- 2. Get associated user_id
  SELECT user_id
    INTO v_user_id
  FROM users_tokens
  WHERE token_id = v_token_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Token is not associated with any user';
  END IF;

  -- 3. Validate user exists (optional if FK exists)
  PERFORM 1
  FROM users
  WHERE id = v_user_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'User does not exist';
  END IF;

  RETURN QUERY SELECT TRUE, v_user_id;
END;
$$;






